{
  "manifest_version": 3,
  "name": "Udemy Subtitle Translate",
  "description": "Zobrazí překlad titulků přímo ve videu na udemy.com – originál + překlad, nebo pouze překlad.",
  "version": "1.6.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.udemy.com/*",
    "https://*.udemycdn.com/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.udemy.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-display-mode": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Přepnout zobrazení: originál + překlad / pouze překlad"
    },
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Zapnout / vypnout překlad"
    },
    "move-up": {
      "suggested_key": { "default": "Alt+Up" },
      "description": "Posunout titulky nahoru"
    },
    "move-down": {
      "suggested_key": { "default": "Alt+Down" },
      "description": "Posunout titulky dolů"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
